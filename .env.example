# 复制为 .env 后填入你自己的值。真实 .env 已被 .gitignore 忽略，不要提交。

# 大模型接口（OpenAI 兼容格式，通义/DeepSeek/GLM/Kimi 均可）
LLM_API_KEY=sk-xxx…xxxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 交叉复核第二模型（D15，--cross-review 启用；建议换不同厂商，异构验证更有说服力）
LLM2_API_KEY=
LLM2_BASE_URL=https://api.deepseek.com
LLM2_MODEL=deepseek-v4-flash
AUDIT_CROSS_REVIEW=0

*** 向量化检索（D12 起需要，可先留空）
EMBEDDING_MODEL=text-embedding-v3
# 聊天服务商无 embeddings 接口时（如 DeepSeek）单独指定向量端点；
# 留空=沿用主配置，向量失败自动退化为关键词检索，不影响审计
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=

# 审计行为
AUDIT_TEMPERATURE=0.1
AUDIT_MAX_RETRY=3
AUDIT_CONSISTENCY_RUNS=1

# 依赖漏洞扫描（可选）：pip-audit 装在独立环境时 PATH 里可能没有它，
# 留空=自动探测（系统 PATH → D:\tools\pip-audit\Scripts\pip-audit.exe）
# PIPAUDIT_BIN=D:\tools\pip-audit\Scripts\pip-audit.exe
